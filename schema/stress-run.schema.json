{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metria.dev/schemas/stress-run/v0.1.json",
  "title": "Metria StressRun",
  "description": "Status-first evidence protocol for an external stress run. v0.1: score is always null (uncalibrated). Ideal Score, grade, band, and weighted protectability blends are forbidden. Normative is experimental and reserved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "subject",
    "policy_digest",
    "started_at",
    "finished_at",
    "budget",
    "overall",
    "lenses",
    "top_risks",
    "evidence_pack"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "runner_image_digest": {
      "type": ["string", "null"]
    },
    "policy_digest": {
      "type": "string",
      "minLength": 1,
      "description": "Hash pin of the StressProfile / policy used for this run."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "overall": {
      "$ref": "#/$defs/OverallStatus"
    },
    "lenses": {
      "$ref": "#/$defs/Lenses"
    },
    "top_risks": {
      "type": "array",
      "description": "Ordered list of risks (text + finding ref). No numeric risk_advisory, grade, or band.",
      "items": {
        "$ref": "#/$defs/TopRisk"
      }
    },
    "evidence_pack": {
      "$ref": "#/$defs/EvidencePack"
    }
  },
  "$defs": {
    "OverallStatus": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    },
    "LensStatus": {
      "type": "string",
      "enum": ["pass", "warn", "fail", "null"]
    },
    "NullReason": {
      "type": "string",
      "enum": [
        "not_declared_by_subject",
        "build_failed",
        "test_env_unavailable",
        "timeout",
        "adapter_gap",
        "tool_error",
        "out_of_scope",
        "missing_inputs"
      ]
    },
    "NullOwner": {
      "type": "string",
      "enum": ["subject", "metria"],
      "description": "subject → human report UNDECLARED; metria → human report NOT MEASURED. Bare NULL is forbidden in human reports."
    },
    "NullDisplay": {
      "type": "string",
      "enum": ["UNDECLARED", "NOT MEASURED"]
    },
    "Confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "Confirmation": {
      "type": "string",
      "enum": ["unconfirmed", "multi_tool", "human_triaged"]
    },
    "LensMaturity": {
      "type": "string",
      "enum": ["core", "experimental"],
      "description": "normative is experimental in v0.1 and out of MVP measurement."
    },
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_url", "commit_sha", "tree_digest"],
      "properties": {
        "repo_url": { "type": "string", "minLength": 1 },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "tree_digest": { "type": "string", "minLength": 1 }
      }
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_s", "used_s"],
      "properties": {
        "wall_clock_s": { "type": "integer", "minimum": 0 },
        "used_s": { "type": "integer", "minimum": 0 }
      }
    },
    "EvidencePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "manifest_sha256"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "TopRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "finding_fingerprint"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "finding_fingerprint": { "type": "string", "minLength": 1 }
      }
    },
    "AnalysisScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages_analyzed",
        "loc_analyzed",
        "loc_total",
        "excluded_paths",
        "exclusion_reasons"
      ],
      "properties": {
        "languages_analyzed": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "loc_analyzed": { "type": "integer", "minimum": 0 },
        "loc_total": { "type": "integer", "minimum": 0 },
        "excluded_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclusion_reasons": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "Tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "ruleset_digest": { "type": ["string", "null"] }
      }
    },
    "Suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "path", "justification", "source"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "source": { "type": "string", "enum": ["subject", "policy"] }
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "title",
        "detectors",
        "confirmation",
        "lens_routing_rule"
      ],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "detectors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "confirmation": { "$ref": "#/$defs/Confirmation" },
        "lens_routing_rule": {
          "type": "string",
          "minLength": 1,
          "description": "Which non-overlap rule routed this finding to this lens."
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SubResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/LensStatus" },
        "raw_metrics": {
          "type": "object",
          "additionalProperties": true
        },
        "null_reason": { "$ref": "#/$defs/NullReason" },
        "null_owner": { "$ref": "#/$defs/NullOwner" },
        "null_display": { "$ref": "#/$defs/NullDisplay" }
      }
    },
    "DimensionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "score",
        "score_reason",
        "confidence",
        "hard_gate_failures",
        "findings",
        "raw_metrics",
        "evidence_refs",
        "analysis_scope",
        "tools",
        "suppressions_applied",
        "maturity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "structural",
            "supply_chain",
            "controls",
            "test_adequacy",
            "architectural",
            "normative"
          ]
        },
        "status": { "$ref": "#/$defs/LensStatus" },
        "score": {
          "type": "null",
          "description": "v0.1: always null until a published calibrated corpus exists."
        },
        "score_reason": {
          "type": "string",
          "const": "uncalibrated"
        },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "null_reason": { "$ref": "#/$defs/NullReason" },
        "null_owner": { "$ref": "#/$defs/NullOwner" },
        "null_display": { "$ref": "#/$defs/NullDisplay" },
        "hard_gate_failures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Finding" }
        },
        "raw_metrics": {
          "type": "object",
          "additionalProperties": true
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "analysis_scope": { "$ref": "#/$defs/AnalysisScope" },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/Tool" }
        },
        "suppressions_applied": {
          "type": "array",
          "items": { "$ref": "#/$defs/Suppression" }
        },
        "sub_results": {
          "type": "array",
          "description": "Split statuses (e.g. inventory vs sbom_practice). No weighted blend.",
          "items": { "$ref": "#/$defs/SubResult" }
        },
        "maturity": { "$ref": "#/$defs/LensMaturity" },
        "rubric_id": {
          "type": ["string", "null"],
          "description": "Optional rubric pin. Not a calibrated score mapping until corpus exists."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "null" } },
            "required": ["status"]
          },
          "then": {
            "required": ["null_reason", "null_owner", "null_display"]
          }
        },
        {
          "if": {
            "properties": { "null_owner": { "const": "subject" } },
            "required": ["null_owner"]
          },
          "then": {
            "properties": {
              "null_display": { "const": "UNDECLARED" }
            }
          }
        },
        {
          "if": {
            "properties": { "null_owner": { "const": "metria" } },
            "required": ["null_owner"]
          },
          "then": {
            "properties": {
              "null_display": { "const": "NOT MEASURED" }
            }
          }
        },
        {
          "if": {
            "properties": { "id": { "const": "normative" } },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "maturity": { "const": "experimental" }
            }
          }
        }
      ]
    },
    "Lenses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural",
        "supply_chain",
        "controls",
        "test_adequacy",
        "architectural",
        "normative"
      ],
      "properties": {
        "structural": { "$ref": "#/$defs/DimensionResult" },
        "supply_chain": { "$ref": "#/$defs/DimensionResult" },
        "controls": { "$ref": "#/$defs/DimensionResult" },
        "test_adequacy": { "$ref": "#/$defs/DimensionResult" },
        "architectural": { "$ref": "#/$defs/DimensionResult" },
        "normative": { "$ref": "#/$defs/DimensionResult" }
      },
      "description": "Five-lens vision retained. Protectability is split into supply_chain + controls (no weighted blend). v1 measures structural, supply_chain, test_adequacy; architectural/normative/controls often UNDECLARED."
    }
  }
}
